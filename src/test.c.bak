int betonIndexOf(char* str)
{
    for (int i=0; i<= gBetonLenght -1; i++)
    {
        if(strcmp(gBetonList[i], str) ==0)
            return i;
    }
    return -1;
}

void showBetsAmountVector(const rowIndex,  const char* beton, const  cl_float* betsAmountVector, const cl_float* betsAmountWithOddsVector)
{
    int index = (gBetonLenght * rowIndex) +  betonIndexOf(beton);
    //printf("index=%d\n", index);
    cl_float ret = betsAmountVector[index];
    log_debug("%s, betsAmountVector[%d]=%f, betsAmountWithOddsVector[%d]=%f\n", beton,  index, betsAmountVector[index], index, betsAmountWithOddsVector[index]);
}

